{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6775842241"
      },
      "android": {
        "serviceAccountKeyPath": "env:EXPO_SERVICE_ACCOUNT_KEY",
        "track": "internal"
      }
    }
  }
}
