# Node / package managers
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds
/ios
/android
*.orig.*

# Metro
.metro-health-check*

# Misc
.DS_Store
*.log

# Firebase / secrets
# ※ google-services.json / GoogleService-Info.plist はここで除外しない。
#   アプリのバイナリに同梱されて配布される設定ファイルで、中のAPIキーも
#   バンドルID/パッケージ名で用途が制限される前提の値なので秘匿情報ではない
#   （Google/Expo とも版管理に含めてよいとしている）。除外していると
#   EAS Build 側にファイルが無く、config plugin が失敗する。
#   秘匿すべきなのは下のサービスアカウントキー（サーバ権限を持つ）のほう。
*.json.key
service-account.json
*-service-account.json
.env
.env.local
.env.*
